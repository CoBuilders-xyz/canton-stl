{
  "name": "@cobuilders/canton-stl",
  "private": true,
  "type": "module",
  "description": "Reusable Canton Sandbox test helpers for Node.js integration tests.",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "prepack": "npm run build",
    "test:package": "node test/check-package.js",
    "test:integration": "node test/check-integration.js",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "node --test test/unit/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  },
  "version": "0.0.0",
  "license": "Apache-2.0",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "README.md"
  ]
}
